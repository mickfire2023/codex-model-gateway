--- /dev/null
+++ b/internal/signature/gateway_antigravity_channel_test.go
@@ -0,0 +1,39 @@
+package signature
+
+import (
+	"bytes"
+	"encoding/base64"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/signature/signaturetest"
+)
+
+// Build only synthetic envelopes. No captured account signatures are used.
+func TestGatewayAntigravityThinkingChannels(t *testing.T) {
+	outer, err := base64.StdEncoding.DecodeString(signaturetest.AntigravityCAQS())
+	if err != nil {
+		t.Fatal("synthetic outer decode failed")
+	}
+	raw, err := base64.StdEncoding.DecodeString(string(outer))
+	if err != nil {
+		t.Fatal("synthetic inner decode failed")
+	}
+	index := bytes.Index(raw, []byte{8, 18, 16, 2, 24, 2})
+	if index < 0 {
+		t.Fatal("synthetic channel field missing")
+	}
+	for _, channel := range []byte{18, 19, 20} {
+		candidate := append([]byte(nil), raw...)
+		candidate[index+1] = channel
+		sig := base64.StdEncoding.EncodeToString([]byte(base64.StdEncoding.EncodeToString(candidate)))
+		_, inspectError := InspectAntigravityClaudeCAQSSignature(sig)
+		normalized, compatible := CompatibleAntigravityClaudeThinkingSignature(sig)
+		want := channel == 18 || channel == 19
+		if (inspectError == nil) != want || compatible != want {
+			t.Errorf("channel %d compatibility mismatch", channel)
+		}
+		if want && normalized != sig {
+			t.Errorf("channel %d changed the opaque signature", channel)
+		}
+	}
+}
